# 关键：不自动安装 peer 依赖。
# @huggingface/transformers（连带 onnxruntime-node ~200MB）是刻意设计的可选依赖，
# 自动安装会让 pnpm install 变成一场灾难，也会让 Electron 安装包翻倍。
auto-install-peers=false
strict-peer-dependencies=false
shamefully-hoist=false
node-linker=isolated
prefer-workspace-packages=true
link-workspace-packages=true

# pnpm 默认不跑 pre/post 钩子，而 predev 里的原生模块重建、打包前的
# 环境还原都必须先于主命令执行 —— 少了它们，要么 better-sqlite3 的 ABI
# 对不上，要么 electron-builder 撞上开发期改过的文件名直接失败。
enable-pre-post-scripts=true
