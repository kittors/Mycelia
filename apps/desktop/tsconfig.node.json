{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "types": ["node", "electron-vite/node"],
    "outDir": "./out-tsc/node"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts", "src/shared/**/*"]
}
