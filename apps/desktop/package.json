{
  "name": "@mycelia/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "predev": "pnpm rebuild && node ../../scripts/dev-app-identity.mjs",
    "prepackage": "node ../../scripts/dev-app-identity.mjs --restore",
    "prepackage:mac": "node ../../scripts/dev-app-identity.mjs --restore",
    "prepackage:win": "node ../../scripts/dev-app-identity.mjs --restore",
    "prepackage:linux": "node ../../scripts/dev-app-identity.mjs --restore",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.7.6",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^12.2.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.27.0",
    "marked": "^18.0.7",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@mycelia/core": "workspace:*",
    "@mycelia/crypto": "workspace:*",
    "@mycelia/daemon": "workspace:*",
    "@mycelia/integrations": "workspace:*",
    "@mycelia/llm": "workspace:*",
    "@mycelia/shared": "workspace:*",
    "@mycelia/store": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "dev.mycelia.app",
    "productName": "Mycelia",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "Mycelia",
        "CFBundleDisplayName": "Mycelia",
        "CFBundleExecutable": "Mycelia"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "executableName": "Mycelia",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "mycelia",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Mycelia",
          "Comment": "连接所有 agent 知识的地下菌丝网络",
          "Categories": "Utility;Development;"
        }
      }
    },
    "nsis": {
      "shortcutName": "Mycelia",
      "uninstallDisplayName": "Mycelia",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "description": "连接所有 agent 知识的地下菌丝网络",
  "author": "Mycelia"
}
