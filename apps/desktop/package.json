{
  "name": "@mycelia/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "predev": "pnpm rebuild"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.7.6",
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^1.27.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@mycelia/core": "workspace:*",
    "@mycelia/crypto": "workspace:*",
    "@mycelia/daemon": "workspace:*",
    "@mycelia/integrations": "workspace:*",
    "@mycelia/shared": "workspace:*",
    "@mycelia/store": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "dev.mycelia.app",
    "productName": "Mycelia",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "build/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "description": "连接所有 agent 知识的地下菌丝网络",
  "author": "Mycelia"
}
